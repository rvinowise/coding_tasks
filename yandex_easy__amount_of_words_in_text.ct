// yandex task 1. Количество слов в тексте
fun main() {
    var line: String?
    var words: MutableSet<String> = mutableSetOf();
    var line_i = 0;
    while (readlnOrNull().also {line = it} != null) {
        line_i++;
        if (!line!!.isEmpty()) {
            //println("split line #$line_i: ${line!!.split("\\s+".toRegex())}")
            words = (words union line!!.split("\\s+".toRegex())).toMutableSet()
        }
        //println("line# $line_i words ${words.size}: ${words.joinToString(" ")}")
    }
    words.remove("");
    var words_amount = words.size
    
    println(words_amount)
}
